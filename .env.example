# X (Twitter) Session Credentials (from browser Cookies at x.com or run pnpm dev:cli -- --login)
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here

# Network Proxy (Required if accessing X or overseas LLMs via local proxy)
HTTP_PROXY=http://127.0.0.1:8118

# ==========================================
# LLM Provider Configuration
# ==========================================
# Provider choices (7大主流厂商及别名):
# - 国外: gemini (Google) | openai / gpt (OpenAI)
# - 国内: deepseek (深度求索) | qwen / qwen-token-plan (阿里通义千问) | zhipu / zhipu-code-plan (智谱清言) | minimax (海螺) | kimi (月之暗面) | custom
LLM_PROVIDER=gemini

# Auth mode:
# - 'account': 账号订阅免Key模式 (走 Google/ChatGPT Plus 订阅配额，零额外 API 账单)
# - 'api_key': 官方 API Key 计费模式
LLM_AUTH_MODE=account

# Optional: Override default model name
# 2026 最新官方主力模型参考（默认全量开启深度思考/推理模式与多模态支持，推理等级默认 high）：
# - gemini: gemini-3.8-flash (默认) | gemini-3.1-pro | gemini-2.5-flash
# - openai / gpt: gpt-5.6-sol (默认，GPT-5.6 Sol 旗舰推理) | gpt-5.6 | gpt-4o
# - deepseek: deepseek-flash (默认，DeepSeek-V4.1-Flash，1M上下文) | deepseek-v4-pro
# - qwen / qwen-token-plan: qwen3.8-flash (默认) | qwen3.8-max | qwen3.7-plus
# - zhipu / zhipu-code-plan: glm-5.3-flash (默认，原生多模态高吞吐) | glm-5.3 (旗舰复杂工程) | glm-5.3-flashx
# - minimax: MiniMax-M3 (默认，1M多模态旗舰，内置思考与 reasoning_split) | MiniMax-M2.7-highspeed
# - kimi: kimi-k3 (默认，2.8T参数旗舰1M上下文，原生全模态推理) | kimi-k2.7-code
LLM_MODEL=

# ==========================================
# LLM Credentials Pool (Fill in based on provider)
# 提示：所有 XXXX_BASE_URL 默认均可留空，系统会自动根据厂家采用官方标准默认端点；
# 仅在需要自建反代、企业网关或第三方聚合中转时才需显式填写。
# ==========================================
# Gemini (Google)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / GPT
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Domestic Providers (OpenAI Compatible)
# 1. DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=

# 2. 阿里通义千问 (Qwen)
# - 普通百炼按量 (provider: qwen): DASHSCOPE_API_KEY 为 sk- 开头，自动使用 https://dashscope.aliyuncs.com/compatible-mode/v1
# - Token Plan 个人/团队版 (provider: qwen-token-plan): DASHSCOPE_API_KEY 为 sk-sp- 开头，系统自动切换至专用端点 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_qwen_dashscope_api_key_here
DASHSCOPE_BASE_URL=

# 3. 智谱清言 (Zhipu)
# - 普通开放平台 API (provider: zhipu): 默认使用 https://open.bigmodel.cn/api/paas/v4
# - Coding Plan 代码专享套餐 (provider: zhipu-code-plan): 自动切换至专用端点 https://open.bigmodel.cn/api/coding/paas/v4
ZHIPUAI_API_KEY=your_zhipu_api_key_here
ZHIPUAI_BASE_URL=

# 4. MiniMax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=

# 5. 月之暗面 (Kimi)
MOONSHOT_API_KEY=your_kimi_moonshot_api_key_here
MOONSHOT_BASE_URL=

# Fetch Configuration
FETCH_MAX_PAGES=3
FETCH_TIMEOUT=60

