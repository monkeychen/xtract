# X (Twitter) Session Credentials (from browser Cookies at x.com or run python main.py --login)
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here

# Network Proxy (Required if accessing X or overseas LLMs via local proxy)
HTTP_PROXY=http://127.0.0.1:8118

# ==========================================
# LLM Provider Configuration
# ==========================================
# Provider choices: gemini | openai | deepseek | qwen | zhipu | minimax | custom
LLM_PROVIDER=gemini

# Auth mode:
# - 'account': Use logged-in subscription session (免 API Key 消费, 走 Google/ChatGPT Plus 订阅配额)
# - 'api_key': Use official API Key (按量计费)
LLM_AUTH_MODE=account

# Optional: Override default model name
LLM_MODEL=

# ==========================================
# LLM Credentials Pool (Fill in based on provider)
# ==========================================
# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Domestic Models (OpenAI Compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DASHSCOPE_API_KEY=your_qwen_dashscope_api_key_here
ZHIPUAI_API_KEY=your_zhipu_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# Fetch Configuration
FETCH_MAX_PAGES=3
FETCH_TIMEOUT=60
