# X (Twitter) Session Credentials (from browser Cookies at x.com or run python main.py --login)
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here

# Network Proxy (Required if accessing X or overseas LLMs via local proxy)
HTTP_PROXY=http://127.0.0.1:8118

# ==========================================
# LLM Provider Configuration
# ==========================================
# Provider choices (7大主流厂商及别名):
# - 国外: gemini (Google) | openai / gpt (OpenAI)
# - 国内: deepseek (深度求索) | qwen (阿里通义千问) | glm / zhipu (智谱清言) | minimax (海螺) | kimi (月之暗面) | custom
LLM_PROVIDER=gemini

# Auth mode:
# - 'account': 账号订阅免Key模式 (走 Google/ChatGPT Plus 订阅配额，零额外 API 账单)
# - 'api_key': 官方 API Key 计费模式
LLM_AUTH_MODE=account

# Optional: Override default model name
# 2026 最新官方主力模型参考：
# - gemini: gemini-3.8-flash (默认) | gemini-3.1-pro | gemini-2.5-flash
# - openai / gpt: gpt-4o (默认) | gpt-4o-mini | o3-mini | o1
# - deepseek: deepseek-flash (默认，V4.1-Flash) | deepseek-v4-pro (注: 旧版 deepseek-chat/reasoner 已停运)
# - qwen: qwen-plus (默认) | qwen-max (Qwen3.8-Max) | qwen-turbo
# - glm / zhipu: glm-5.3 (默认，旗舰代码与长程任务) | glm-5.3-flash (原生多模态主力) | glm-5.3-flashx (极速版)
# - minimax: MiniMax-M3 (默认，1M多模态旗舰) | MiniMax-M2.7-highspeed | MiniMax-Text-01
# - kimi: kimi-k3 (默认，2.8T参数旗舰1M上下文) | kimi-k2.7-code | kimi-k2.6 (注: 旧版 moonshot-v1 已停运)
LLM_MODEL=

# ==========================================
# LLM Credentials Pool (Fill in based on provider)
# ==========================================
# Gemini (Google)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / GPT
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Domestic Providers (OpenAI Compatible)
# 1. DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=

# 2. 阿里通义千问 (Qwen)
# - 普通百炼按量: DASHSCOPE_API_KEY 为 sk- 开头，自动使用 https://dashscope.aliyuncs.com/compatible-mode/v1
# - Token Plan 个人/团队版: DASHSCOPE_API_KEY 为 sk-sp- 开头，系统自动切换至专用端点 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_qwen_dashscope_api_key_here
DASHSCOPE_BASE_URL=

# 3. 智谱清言 (GLM)
# - 普通开放平台 API: 默认使用 https://open.bigmodel.cn/api/paas/v4
# - Coding Plan 代码专享套餐: 设置 ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4 或使用 provider=glm_code_plan
ZHIPUAI_API_KEY=your_zhipu_glm_api_key_here
ZHIPUAI_BASE_URL=

# 4. MiniMax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=

# 5. 月之暗面 (Kimi)
MOONSHOT_API_KEY=your_kimi_moonshot_api_key_here
MOONSHOT_BASE_URL=

# Fetch Configuration
FETCH_MAX_PAGES=3
FETCH_TIMEOUT=60

