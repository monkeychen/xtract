{
  "name": "xtract",
  "version": "0.1.0",
  "description": "Production-grade X (Twitter) intelligence radar & AI digest.",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite",
    "dev:cli": "tsx src/main/index.ts",
    "build": "vite build && tsx scripts/build.ts",
    "build:app": "vite build && tsx scripts/build.ts && electron-builder",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "verify": "pnpm lint && pnpm test && tsc --noEmit && vite build"
  },
  "keywords": [
    "twitter",
    "x",
    "ai",
    "digest",
    "radar",
    "playwright",
    "electron",
    "llm"
  ],
  "author": "chenzhian <cza55007@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.50.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^42.11.8",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "node-gyp": "^13.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
