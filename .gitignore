# ==============================================================================
data/*.db
data/*.sqlite
data/*.sqlite3
data/tweets.db
data/raw/*
!data/raw/.gitkeep
data/*.log
*.log

# 导出的推文阅读归档 (早报 reports 纳入版本控制或按需忽略)
output/tweets_*.md
output/

